generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                RoleName             @unique
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  pricingRules        PricingRule[]
  roleUpgradeRequests RoleUpgradeRequest[] @relation("RequestedRole")
  users               User[]

  @@map("roles")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId               String                @map("role_id") @db.Uuid
  firstName            String                @map("first_name") @db.VarChar(100)
  lastName             String                @map("last_name") @db.VarChar(100)
  email                String                @unique @db.VarChar(255)
  phone                String                @unique @db.VarChar(20)
  passwordHash         String?               @map("password_hash")
  referralCode         String                @unique @map("referral_code") @db.VarChar(20)
  referredBy           String?               @map("referred_by") @db.Uuid
  isEmailVerified      Boolean               @default(false) @map("is_email_verified")
  googleId             String?               @unique @map("google_id") @db.VarChar(255)
  status               UserStatus            @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  esimOrders           EsimOrder[]
  notifications        Notification[]
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
  paymentTransactions  PaymentTransaction[]
  referralReceived     Referral?             @relation("ReferredUser")
  referralsMade        Referral[]            @relation("ReferrerUser")
  refreshTokens        RefreshToken[]
  roleUpgradeRequests  RoleUpgradeRequest[]  @relation("UpgradeRequester")
  reviewedUpgrades     RoleUpgradeRequest[]  @relation("UpgradeReviewer")
  senderIdRequests     SenderIdRequest[]
  senderIds            SenderId[]
  smsCampaigns         SmsCampaign[]
  smsWallet            SmsWallet?
  supportConversations SupportConversation[]
  referrer             User?                 @relation("UserReferrals", fields: [referredBy], references: [id])
  referrals            User[]                @relation("UserReferrals")
  role                 Role                  @relation(fields: [roleId], references: [id])
  wallet               Wallet?

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Wallet {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @unique @map("user_id") @db.Uuid
  balance       Decimal             @default(0) @db.Decimal(18, 2)
  lockedBalance Decimal             @default(0) @map("locked_balance") @db.Decimal(18, 2)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions  WalletTransaction[]
  user          User                @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model WalletTransaction {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String                  @map("wallet_id") @db.Uuid
  transactionType WalletTransactionType   @map("transaction_type")
  amount          Decimal                 @db.Decimal(18, 2)
  balanceBefore   Decimal                 @map("balance_before") @db.Decimal(18, 2)
  balanceAfter    Decimal                 @map("balance_after") @db.Decimal(18, 2)
  reference       String                  @unique @db.VarChar(100)
  status          WalletTransactionStatus @default(PENDING)
  description     String?
  metadata        Json?
  orderId         String?                 @map("order_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet          Wallet                  @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([reference])
  @@map("wallet_transactions")
}

model PaymentTransaction {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  gateway          PaymentGateway
  gatewayReference String         @unique @map("gateway_reference") @db.VarChar(255)
  amount           Decimal        @db.Decimal(18, 2)
  status           PaymentStatus  @default(PENDING)
  payload          Json?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([gatewayReference])
  @@map("payment_transactions")
}

model ProcessedWebhook {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateway          String   @db.VarChar(50)
  gatewayReference String   @unique @map("gateway_reference") @db.VarChar(255)
  payload          Json?
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([gatewayReference])
  @@map("processed_webhooks")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

model Product {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  name         String        @db.VarChar(255)
  code         String        @unique @db.VarChar(100)
  providerCost Decimal       @map("provider_cost") @db.Decimal(18, 2)
  active       Boolean       @default(true)
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems   OrderItem[]
  pricingRules PricingRule[]
  category     Category      @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("products")
}

model PricingRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  sellingPrice Decimal  @map("selling_price") @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id])
  role         Role     @relation(fields: [roleId], references: [id])

  @@unique([productId, roleId])
  @@map("pricing_rules")
}

model Provider {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                   @db.VarChar(100)
  providerType       ProviderType             @map("provider_type")
  priority           Int                      @default(1)
  active             Boolean                  @default(true)
  config             Json?
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  reconciliationJobs OrderReconciliationJob[]
  orders             Order[]
  providerHealth     ProviderHealth?

  @@map("providers")
}

model ProviderHealth {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId          String    @unique @map("provider_id") @db.Uuid
  isHealthy           Boolean   @default(true) @map("is_healthy")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(6)
  cooldownUntil       DateTime? @map("cooldown_until") @db.Timestamptz(6)
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider            Provider  @relation(fields: [providerId], references: [id])

  @@map("provider_health")
}

model Order {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                   @map("user_id") @db.Uuid
  providerId           String?                  @map("provider_id") @db.Uuid
  orderType            OrderType                @map("order_type")
  amount               Decimal                  @db.Decimal(18, 2)
  providerCostSnapshot Decimal                  @map("provider_cost_snapshot") @db.Decimal(18, 2)
  sellingPriceSnapshot Decimal                  @map("selling_price_snapshot") @db.Decimal(18, 2)
  profitSnapshot       Decimal                  @map("profit_snapshot") @db.Decimal(18, 2)
  status               OrderStatus              @default(PENDING)
  reference            String                   @unique @db.VarChar(100)
  providerReference    String?                  @map("provider_reference") @db.VarChar(255)
  providerResponse     Json?                    @map("provider_response")
  metadata             Json?
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems           OrderItem[]
  reconciliationJobs   OrderReconciliationJob[]
  provider             Provider?                @relation(fields: [providerId], references: [id])
  user                 User                     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(18, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(18, 2)
  metadata   Json?
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderReconciliationJob {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String               @map("order_id") @db.Uuid
  providerId    String               @map("provider_id") @db.Uuid
  status        ReconciliationStatus @default(PENDING)
  attempts      Int                  @default(0)
  lastAttemptAt DateTime?            @map("last_attempt_at") @db.Timestamptz(6)
  resolvedAt    DateTime?            @map("resolved_at") @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  order         Order                @relation(fields: [orderId], references: [id])
  provider      Provider             @relation(fields: [providerId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("order_reconciliation_jobs")
}

model Referral {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId     String    @map("referrer_id") @db.Uuid
  referredUserId String    @unique @map("referred_user_id") @db.Uuid
  rewardAmount   Decimal   @map("reward_amount") @db.Decimal(18, 2)
  rewarded       Boolean   @default(false)
  rewardedAt     DateTime? @map("rewarded_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  referredUser   User      @relation("ReferredUser", fields: [referredUserId], references: [id])
  referrer       User      @relation("ReferrerUser", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

model RoleUpgradeRequest {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId     String            @map("requester_id") @db.Uuid
  requestedRoleId String            @map("requested_role_id") @db.Uuid
  status          RoleUpgradeStatus @default(PENDING)
  reason          String?
  reviewedBy      String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  requestedRole   Role              @relation("RequestedRole", fields: [requestedRoleId], references: [id])
  requester       User              @relation("UpgradeRequester", fields: [requesterId], references: [id])
  reviewer        User?             @relation("UpgradeReviewer", fields: [reviewedBy], references: [id])

  @@index([requesterId])
  @@index([status])
  @@map("role_upgrade_requests")
}

model SmsWallet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  credits   BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@map("sms_wallets")
}

model SmsCampaign {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  campaignName        String       @map("campaign_name") @db.VarChar(255)
  senderId            String       @map("sender_id") @db.VarChar(50)
  messageBody         String       @map("message_body")
  totalRecipients     Int          @default(0) @map("total_recipients")
  totalSent           Int          @default(0) @map("total_sent")
  totalFailed         Int          @default(0) @map("total_failed")
  status              String       @default("DRAFT") @db.VarChar(50)
  scheduledAt         DateTime?    @map("scheduled_at") @db.Timestamptz(6)
  completedAt         DateTime?    @map("completed_at") @db.Timestamptz(6)
  usedDefaultSenderId Boolean      @default(false) @map("used_default_sender_id")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User         @relation(fields: [userId], references: [id])
  messages            SmsMessage[]

  @@index([userId])
  @@map("sms_campaigns")
}

model SmsMessage {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId       String      @map("campaign_id") @db.Uuid
  recipient        String      @db.VarChar(20)
  message          String
  deliveryStatus   String      @default("PENDING") @map("delivery_status") @db.VarChar(50)
  providerResponse Json?       @map("provider_response")
  sentAt           DateTime?   @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign         SmsCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@map("sms_messages")
}

model SenderId {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  senderId  String         @map("sender_id") @db.VarChar(50)
  isDefault Boolean        @default(false) @map("is_default")
  status    SenderIdStatus @default(DEFAULT)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sender_ids")
}

model SenderIdRequest {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  requestedSenderId      String                @map("requested_sender_id") @db.VarChar(50)
  status                 SenderIdRequestStatus @default(PENDING)
  rejectionReason        String?               @map("rejection_reason")
  carrierRejectionReason String?               @map("carrier_rejection_reason")
  reviewedBy             String?               @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  submittedToCarrierAt   DateTime?             @map("submitted_to_carrier_at") @db.Timestamptz(6)
  activatedAt            DateTime?             @map("activated_at") @db.Timestamptz(6)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User                  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("sender_id_requests")
}

model EsimProduct {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country       String      @db.VarChar(100)
  countryCode   String      @map("country_code") @db.VarChar(10)
  packageName   String      @map("package_name") @db.VarChar(255)
  dataAllowance String      @map("data_allowance") @db.VarChar(50)
  validity      String      @db.VarChar(50)
  costPrice     Decimal     @map("cost_price") @db.Decimal(18, 2)
  sellingPrice  Decimal     @map("selling_price") @db.Decimal(18, 2)
  providerCode  String?     @map("provider_code") @db.VarChar(100)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders        EsimOrder[]

  @@index([country])
  @@map("esim_products")
}

model EsimOrder {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  esimProductId     String          @map("esim_product_id") @db.Uuid
  iccid             String?         @db.VarChar(50)
  qrCodeUrl         String?         @map("qr_code_url")
  activationDetails Json?           @map("activation_details")
  status            EsimOrderStatus @default(PENDING)
  isDisputed        Boolean         @default(false) @map("is_disputed")
  disputeReason     String?         @map("dispute_reason")
  providerReference String?         @map("provider_reference") @db.VarChar(255)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  esimProduct       EsimProduct     @relation(fields: [esimProductId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("esim_orders")
}

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  title     String              @db.VarChar(255)
  body      String
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model SupportConversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  source    SupportSource
  status    SupportStatus    @default(OPEN)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id])
  messages  SupportMessage[]

  @@index([userId])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  senderType     MessageSenderType   @map("sender_type")
  message        String
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("support_messages")
}

model ApiKey {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  apiKey        String        @unique @map("api_key")
  apiSecretHash String        @map("api_secret_hash")
  label         String?       @db.VarChar(100)
  status        ApiKeyStatus  @default(ACTIVE)
  lastUsedAt    DateTime?     @map("last_used_at") @db.Timestamptz(6)
  webhookUrl    String?       @map("webhook_url")
  user          User          @relation(fields: [userId], references: [id])
  usageLogs     ApiUsageLog[]

  @@index([userId])
  @@map("api_keys")
}

model ApiUsageLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apiKeyId     String   @map("api_key_id") @db.Uuid
  endpoint     String   @db.VarChar(255)
  method       String   @db.VarChar(10)
  statusCode   Int      @map("status_code")
  responseTime Int?     @map("response_time")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
  @@map("api_usage_logs")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum RoleName {
  CUSTOMER
  RESELLER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  BONUS
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentGateway {
  PAYSTACK
  MONNIFY
}

enum PaymentStatus {
  PENDING
  SUCCESS
